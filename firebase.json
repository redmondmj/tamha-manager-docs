{
  "hosting": {
    "public": "app/public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "rewrites": [
      { "source": "/", "destination": "/auditor.html" },
      { "source": "/checklist", "destination": "/index.html" },
      { "source": "/manager-docs", "destination": "/index.html" }
    ]
  }
}
